# Copy to secrets.env (gitignored) and replace every value. Placeholders only; never commit real values.
# Use with: docker compose --env-file secrets.env ...
POSTGRES_PASSWORD=change-me-postgres-password
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
# Issued by Discord (Developer Portal, OAuth2); dev app locally, prod app on the server.
DISCORD_CLIENT_SECRET=change-me-discord-client-secret
